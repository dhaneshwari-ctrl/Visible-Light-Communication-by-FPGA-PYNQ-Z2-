###############################################################################
# PYNQ-Z2 CONSTRAINT FILE
#
# Target:
#   xc7z020clg400-1
#
# Top:
#   audio_1_wrapper
#
###############################################################################


###############################################################################
# LI-FI TRANSMITTER
###############################################################################

# GPIO2_0_tri_o[0]
#
# LiFi TX output to LED driver / MCP1407.
#
# Previous TX pin:
#   Y18
#
set_property PACKAGE_PIN Y18 [get_ports {GPIO2_0_tri_o[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {GPIO2_0_tri_o[0]}]


###############################################################################
# LI-FI RECEIVER
###############################################################################

# LiFi receiver input.
#
# PYNQ-Z2 PMOD / GPIO pin previously used:
#   W14
#
set_property PACKAGE_PIN W14 [get_ports {lifi_rx_gpio_tri_i[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {lifi_rx_gpio_tri_i[0]}]


###############################################################################
# AUDIO CODEC I2C
###############################################################################

# IMPORTANT:
#
# Your new wrapper has FOUR I2C-related top-level ports:
#
#   scl_io_0
#   sda_io_0
#   scl_io_axi_iic
#   sda_io_axi_iic
#
# DO NOT blindly constrain both pairs to the same physical pins.
#
# First determine which pair is actually connected to the ADAU1761 I2C
# interface in the block design.
#
# If scl_io_0 / sda_io_0 are the actual codec I2C pins, use:
#

set_property PACKAGE_PIN U9 [get_ports {scl_io_0}]
set_property PACKAGE_PIN T9 [get_ports {sda_io_0}]

set_property IOSTANDARD LVCMOS33 [get_ports {scl_io_0}]
set_property IOSTANDARD LVCMOS33 [get_ports {sda_io_0}]

set_property PULLUP TRUE [get_ports {scl_io_0}]
set_property PULLUP TRUE [get_ports {sda_io_0}]


# DO NOT assign PACKAGE_PIN to:
#
 set_property PACKAGE_PIN Y19 [get_ports {scl_io_axi_iic}]
set_property PACKAGE_PIN Y16 [get_ports {sda_io_axi_iic}]

set_property IOSTANDARD LVCMOS33 [get_ports {scl_io_axi_iic}]
set_property IOSTANDARD LVCMOS33 [get_ports {sda_io_axi_iic}]

set_property PULLUP TRUE [get_ports {scl_io_axi_iic}]
set_property PULLUP TRUE [get_ports {sda_io_axi_iic}]
# unless these are separately connected to physical external I2C pins.
#
# If they are internal connections between IP blocks, they need no XDC
# PACKAGE_PIN constraint.

set_property PACKAGE_PIN R14 [get_ports {GPIO2_0_tri_t[0]}]
set_property PACKAGE_PIN P14 [get_ports {lifi_rx_gpio_tri_t[0]}]


set_property IOSTANDARD LVCMOS33 [get_ports {GPIO2_0_tri_t[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {lifi_rx_gpio_tri_t[0]}]


###############################################################################
# AUDIO CLOCK
###############################################################################

set_property -dict {PACKAGE_PIN U5 IOSTANDARD LVCMOS33} \
    [get_ports {audio_clk_10MHz}]


###############################################################################
# CODEC ADDRESS
###############################################################################

# ADAU1761 codec address pins.
#
# Previous assignments:
#   codec_address_0[0] -> M17
#   codec_address_0[1] -> M18
#

set_property PACKAGE_PIN M17 [get_ports {codec_address_0[0]}]
set_property PACKAGE_PIN M18 [get_ports {codec_address_0[1]}]

set_property IOSTANDARD LVCMOS33 [get_ports {codec_address_0[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {codec_address_0[1]}]


###############################################################################
# AUDIO CODEC - I2S
###############################################################################

# I2S BIT CLOCK
# Codec BCLK = R18

set_property PACKAGE_PIN R18 [get_ports {BCLK_O_0[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {BCLK_O_0[0]}]


# I2S LEFT/RIGHT CLOCK
# Codec LRCLK = T17

set_property PACKAGE_PIN T17 [get_ports {LRCLK_O_0[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {LRCLK_O_0[0]}]


# I2S DATA FPGA -> CODEC
# Codec SDATA = G18

set_property PACKAGE_PIN G18 [get_ports {SDATA_O_0[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {SDATA_O_0[0]}]


# I2S DATA CODEC -> FPGA
# Codec SDATA input to FPGA = F17

set_property PACKAGE_PIN F17 [get_ports {SDATA_I_0[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {SDATA_I_0[0]}]


